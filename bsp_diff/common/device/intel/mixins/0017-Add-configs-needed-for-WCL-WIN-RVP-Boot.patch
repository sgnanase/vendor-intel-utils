From e801ed9e4e27689badcd0924b11b9a727f023f26 Mon Sep 17 00:00:00 2001
From: "Tekriwal, Tanuj" <tanuj.tekriwal@intel.corp-partner.google.com>
Date: Wed, 10 Jun 2026 04:12:05 +0000
Subject: [PATCH] Add configs needed for WCL-WIN RVP Boot

Tracked-On: NA
Signed-off-by: Tekriwal, Tanuj <tanuj.tekriwal@intel.corp-partner.google.com>
---
 .../config-lts/lts2024-android/x86_64_defconfig | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/groups/kernel/gmin64/config-lts/lts2024-android/x86_64_defconfig b/groups/kernel/gmin64/config-lts/lts2024-android/x86_64_defconfig
index 75cf257..f105cb2 100644
--- a/groups/kernel/gmin64/config-lts/lts2024-android/x86_64_defconfig
+++ b/groups/kernel/gmin64/config-lts/lts2024-android/x86_64_defconfig
@@ -196,21 +196,30 @@ CONFIG_PAGE_COUNTER=y
 # CONFIG_CGROUP_FAVOR_DYNMODS is not set
 CONFIG_MEMCG=y
 # CONFIG_MEMCG_V1 is not set
-# CONFIG_BLK_CGROUP is not set
+CONFIG_BLK_CGROUP=y
+CONFIG_BLK_CGROUP_RWSTAT=y
+# CONFIG_BLK_CGROUP_IOCOST is not set
+# CONFIG_BLK_CGROUP_IOLATENCY is not set
+# CONFIG_BLK_CGROUP_IOPRIO is not set
+# CONFIG_BLK_DEV_THROTTLING is not set
+CONFIG_BFQ_GROUP_IOSCHED=y
+# CONFIG_BFQ_CGROUP_DEBUG is not set
+CONFIG_CGROUP_WRITEBACK=y
+# CONFIG_F2FS_UNFAIR_RWSEM is not set
 CONFIG_CGROUP_SCHED=y
 CONFIG_GROUP_SCHED_WEIGHT=y
 CONFIG_FAIR_GROUP_SCHED=y
 # CONFIG_CFS_BANDWIDTH is not set
 # CONFIG_RT_GROUP_SCHED is not set
 CONFIG_SCHED_MM_CID=y
-# CONFIG_CGROUP_PIDS is not set
+CONFIG_CGROUP_PIDS=y
 # CONFIG_CGROUP_RDMA is not set
 CONFIG_CGROUP_FREEZER=y
 # CONFIG_CGROUP_HUGETLB is not set
 CONFIG_CPUSETS=y
-# CONFIG_CPUSETS_V1 is not set
+CONFIG_CPUSETS_V1=y
 CONFIG_PROC_PID_CPUSET=y
-# CONFIG_CGROUP_DEVICE is not set
+CONFIG_CGROUP_DEVICE=y
 CONFIG_CGROUP_CPUACCT=y
 # CONFIG_CGROUP_PERF is not set
 CONFIG_CGROUP_BPF=y
-- 
