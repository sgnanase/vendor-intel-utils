 tasks/code_check.mk  | 28 ++++++-------
 tasks/flashfiles.mk  | 44 +++++++++++++-------
 tasks/publish.mk     | 98 ++++++++++++++++++++++++++++++++++----------
 4 files changed, 123 insertions(+), 53 deletions(-)
 mode change 100755 => 100644 tasks/flashfiles.mk

diff --git a/tasks/checkvendor.mk b/tasks/checkvendor.mk
index 6d36d23..9d5e2fd 100644
--- a/tasks/checkvendor.mk
+++ b/tasks/checkvendor.mk
